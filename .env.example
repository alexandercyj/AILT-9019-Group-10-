# Copy to .env and fill in your own key. The core path does not read this file.
# Without a key, `--llm` replays the recorded transcript in data/llm_transcripts.json.
LABELDESK_API_KEY=
LABELDESK_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LABELDESK_MODEL=deepseek-v4.1-flash
